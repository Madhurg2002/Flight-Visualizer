{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@convex/*": ["./convex/*"],
      "@skytrace/types": ["../../packages/types/src/index.ts"],
      "@skytrace/data": ["../../packages/data/src/index.ts"],
      "@skytrace/data/routes.generated": ["../../packages/data/src/routes.generated.ts"],
      "@skytrace/flight-core": ["../../packages/flight-core/src/index.ts"],
