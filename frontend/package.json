{
  "name": "@skytrace/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:all": "concurrently -n backend,web,watch -c magenta,cyan,yellow \"bun run --cwd ../backend dev\" \"bun run dev\" \"bun run --cwd ../backend watch:packages\"",
