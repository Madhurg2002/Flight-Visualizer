{
  "name": "skytrace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "common/*"
  ],
  "scripts": {
    "dev": "bun run --cwd frontend dev:all",
    "web": "bun run --cwd frontend dev",
    "api": "bun run --cwd backend dev",
    "start": "bun run --cwd backend start",
    "build": "bun run --cwd frontend build",
    "typecheck": "tsc -b --noEmit",
    "data:build": "bun run common/data/scripts/build-data.ts",
    "check:resolver": "bun run common/flight-core/scripts/parse-check.ts",
    "check:csv": "bun run frontend/scripts/check-csv.ts",
    "check:api": "bun run --cwd backend scripts/check-api.ts",
    "check": "bun run check:resolver && bun run check:csv && bun run check:api",
    "db:push": "bun run --cwd backend db:push",
    "db:seed": "bun run --cwd backend db:seed",
    "db:generate": "bun run --cwd backend db:generate"
  },
  "dependencies": {
    "@skytrace/data": "workspace:*",
    "@skytrace/flight-core": "workspace:*",
    "@skytrace/types": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.3",
    "typescript": "^5.7.3"
  }
}
