{
  "name": "skytrace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "backend",
    "frontend",
    "common/*"
  ],
  "scripts": {
    "dev": "bun run --cwd frontend dev:all",
    "web": "bun run --cwd frontend dev",
    "backend": "bun run --cwd backend dev",
    "build": "bun run --cwd frontend build",
    "typecheck": "tsc -b --noEmit",
    "data:build": "bun run common/data/scripts/build-data.ts",
    "check:resolver": "bun run common/flight-core/scripts/parse-check.ts",
    "check:csv": "bun run frontend/scripts/check-csv.ts",
    "check": "bun run check:resolver && bun run check:csv",
    "convex": "bun run --cwd backend convex"
  },
  "dependencies": {
    "@skytrace/data": "workspace:*",
    "@skytrace/flight-core": "workspace:*",
    "@skytrace/types": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "convex": "^1.46.0",
    "typescript": "^5.7.3"
  }
}
